{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "allowArbitraryExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
